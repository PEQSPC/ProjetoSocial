{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2023"],
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "src",
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,

    "ignoreDeprecations": "6.0",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
