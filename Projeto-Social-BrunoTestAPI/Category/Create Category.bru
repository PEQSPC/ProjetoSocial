meta {
  name: Create Category
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/api/categories
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Fresh Fruits",
    "type": "FOOD" 
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
